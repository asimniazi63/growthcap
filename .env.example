# Copy to .env.local and fill in. .env.local is never committed. Names only here, no values.

# Clerk (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/connect

# Neon (pooled connection string)
DATABASE_URL=

# Shopify product app (Dev Dashboard > app > Settings > Credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The production URL, e.g. https://oasis-pace.vercel.app
SHOPIFY_APP_URL=

# Shopify seeder app (local seeding only, never deployed)
SEEDER_CLIENT_ID=
SEEDER_CLIENT_SECRET=
SOLENNE_SHOP_DOMAIN=
TIDEPOOL_SHOP_DOMAIN=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Checked by the nightly job: openssl rand -hex 32
CRON_SECRET=

# Amazon Bedrock: a Bedrock API key (the AI SDK provider reads AWS_BEARER_TOKEN_BEDROCK itself)
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=

# Langfuse (not needed until T15)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Agent (T4). Set to true once AWS has granted Claude access on Bedrock; until then Devstral is used.
BEDROCK_CLAUDE_ENABLED=
# Each brand's model spend cap per UTC day, in US dollars (default 5)
TENANT_DAILY_BUDGET_USD=
